type Highlight = { icon: React.ElementType; text: string };

type Project = {
  title: string;
  tagline: string;
  company: string;
  description: string;
  highlights: Highlight[];
  techStack: { category: string; items: string[] }[];
  features: string[];
  liveUrl?: string;
  githubUrl?: string;
  type: string;
  status: "Live" | "In Development" | "Shipped";
  featured: boolean;
};

